<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Little Gull Cottages &amp; Resort &middot; Arry's Roofing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
<style>
/* ============================================================
     ARRY'S BRAND STANDARDS V.1
     Black · Gold · Cream. One metal, no second accent.
     Inter for the contract. Playfair Display italic for the warmth.
     4px base grid · 1200px container · 24px card.
     ============================================================ */
  :root{
    --black:#000000;
    --gold:#EFC459;
    --gold-bright:#FBE67B;
    --gold-mid:#F7D14E;
    --gold-dark:#D4A041;
    --gold-brown:#8C421D;
    --charcoal:#3A3A3A;
    --cream:#FFFAE3;
    --cream-pale:#FCFBE7;
    --white:#FFFFFF;
    --muted:#888888;
    --gradient-gold:linear-gradient(160deg,#8C421D 0%,#FBE67B 33%,#FCFBE7 54%,#F7D14E 77%,#D4A041 100%);

    --space-2:8px; --space-3:12px; --space-4:16px; --space-6:24px;
    --space-8:32px; --space-12:48px; --space-16:64px; --space-20:80px;
    --container-max:1200px; --card-padding:24px;
    --radius-sm:4px; --radius-md:8px; --radius-lg:16px;
    --shadow-sm:0 2px 8px rgba(0,0,0,.10);
    --shadow-md:0 4px 24px rgba(0,0,0,.14);
    --shadow-lg:0 8px 40px rgba(0,0,0,.20);
    --shadow-gold:0 4px 24px rgba(239,196,89,.30);

    --sans:'Inter','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
    --serif:'Playfair Display',Georgia,'Times New Roman',serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--cream);color:var(--charcoal);font-family:var(--sans);font-weight:400;
    font-size:14px;line-height:1.5;overflow-x:hidden;-webkit-font-smoothing:antialiased}

  /* ---- type scale ---- */
  h1,h2,h3{font-family:var(--sans);color:var(--black)}
  .h1{font-weight:700;font-size:clamp(28px,4vw,36px);line-height:1.1;letter-spacing:-.02em}
  .h3{font-weight:700;font-size:20px;line-height:1.25;letter-spacing:-.01em}
  .sub{font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:clamp(19px,2.4vw,24px);line-height:1.25;color:var(--gold-dark);margin-top:var(--space-3)}
  .body{font-size:14px;line-height:1.5;color:var(--charcoal);max-width:66ch;margin-top:var(--space-6)}
  .body strong{font-weight:700;color:var(--black)}
  .body + .body{margin-top:var(--space-4)}
  .cap{font-size:11px;line-height:1.5;color:var(--muted)}
  .lbl{font-weight:700;font-size:13px;letter-spacing:.30em;text-transform:uppercase}

  /* ---- inverse surfaces ---- */
  .dark{background:var(--black);color:var(--cream-pale)}
  .dark h1,.dark h2,.dark h3{color:var(--cream-pale)}
  .dark .body{color:#C9C4B4}
  .dark .body strong{color:var(--cream-pale)}
  .dark .sub{color:var(--gold)}
  .dark .cap{color:#7d7a72}
  .gd{color:var(--gold-dark)} .dark .gd{color:var(--gold)}

  section{position:relative;padding:var(--space-16) var(--space-8);z-index:2}
  .wrap{max-width:var(--container-max);margin:0 auto}
  @media(max-width:720px){section{padding:var(--space-12) var(--space-6)}}

  /* ---- COMPONENT 01 · section header rail ---- */
  .rail{border-top:1px solid currentColor;border-bottom:1px solid currentColor;
    padding:var(--space-3) 0;display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;
    font-weight:700;font-size:11px;letter-spacing:.30em;text-transform:uppercase;color:var(--gold-dark)}
  .dark .rail{color:var(--gold)}
  .rail .mid{opacity:.75}
  .rail .t2{color:var(--charcoal)}
  .dark .rail .t2{color:var(--muted)}
  .rail + .h1{margin-top:var(--space-8)}
  @media(max-width:720px){.rail{font-size:10px;letter-spacing:.24em}}

  /* ---- COMPONENT 02 · stat block ---- */
  .statblock{display:grid;grid-template-columns:repeat(4,1fr);
    border-top:1px solid currentColor;border-bottom:1px solid currentColor;
    margin-top:var(--space-12);color:var(--gold-dark)}
  .dark .statblock{color:var(--gold)}
  @media(max-width:820px){.statblock{grid-template-columns:repeat(2,1fr)}}
  .sb{padding:var(--space-8) var(--space-4);text-align:center}
  .sb .n{font-weight:700;font-size:clamp(32px,4.4vw,52px);line-height:1;letter-spacing:-.025em;color:var(--black)}
  .dark .sb .n{color:var(--gold)}
  .sb .n small{font-size:.42em;font-weight:700;letter-spacing:0}
  .sb .l{font-weight:700;font-size:10px;letter-spacing:.30em;text-transform:uppercase;
    color:var(--muted);margin-top:var(--space-3);line-height:1.8}

  /* ---- COMPONENT 03 · numbered feature list ---- */
  .numlist{list-style:none;margin-top:var(--space-12);display:grid;gap:var(--space-8);
    grid-template-columns:repeat(2,1fr)}
  @media(max-width:720px){.numlist{grid-template-columns:1fr;gap:var(--space-6)}}
  .numlist li .num{font-weight:700;font-size:13px;letter-spacing:.30em;color:var(--gold-dark);display:block;margin-bottom:var(--space-2)}
  .dark .numlist li .num{color:var(--gold)}
  .numlist li h3{font-weight:700;font-size:16px;line-height:1.3;color:var(--black);margin-bottom:var(--space-2)}
  .dark .numlist li h3{color:var(--cream-pale)}
  .numlist li p{font-size:13px;line-height:1.5;color:var(--charcoal)}
  .dark .numlist li p{color:#C9C4B4}
  .numlist li p b{font-weight:700;color:var(--black)}
  .dark .numlist li p b{color:var(--gold-bright)}

  /* ---- COMPONENT 04 · numbered card stack ---- */
  .cardstack{list-style:none;margin-top:var(--space-12);display:grid;gap:var(--space-4);
    grid-template-columns:repeat(2,1fr)}
  @media(max-width:820px){.cardstack{grid-template-columns:1fr}}
  .cardstack li{background:var(--white);border:1px solid rgba(58,58,58,.12);border-radius:var(--radius-md);
    padding:var(--card-padding);box-shadow:var(--shadow-sm)}
  .dark .cardstack li{background:#0b0b0b;border-color:rgba(239,196,89,.22)}
  .cardstack .num{font-weight:700;font-size:13px;letter-spacing:.30em;color:var(--gold-dark);display:block;margin-bottom:var(--space-2)}
  .dark .cardstack .num{color:var(--gold)}
  .cardstack h3{font-weight:700;font-size:16px;line-height:1.3;color:var(--black);margin-bottom:var(--space-2)}
  .dark .cardstack h3{color:var(--cream-pale)}
  .cardstack p{font-size:13px;line-height:1.5;color:var(--charcoal)}
  .dark .cardstack p{color:#C9C4B4}

  /* ---- shared vs. option-specific scope lines ----

     On an optionSet the three scope pages are mostly the same page. That is
     honest — the tear-off, the wood repairs, the fascia rebuild and the
     penetrations genuinely do not change with the panel — but read straight
     through it looks like three copies of one document, and the two lines that
     actually differ get lost in the middle of five that do not.

     So each card declares which it is. Option-specific lines take a gold left
     rule and a gold tag; shared lines are dimmed and tagged as shared. The
     reader can then skim the gold and find the whole difference between
     $133,200 and $207,840 in about four seconds.

     Gold text lives only on the dark scope pages. On cream, .tag.only falls
     back to gold-brown (6.88:1) — gold itself is 1.58:1 on cream and unusable
     as text. */
  .cardstack li.only{border-left:3px solid var(--gold-dark)}
  .dark .cardstack li.only{border-left-color:var(--gold);
    box-shadow:inset 0 0 0 1px rgba(239,196,89,.10)}
  /* Recede by surface and border, never by opacity — opacity multiplies the
     text against the background too, and these cards are already carrying 9px
     tracked caps that have no contrast to spare. */
  .cardstack li.shared{background:var(--cream-pale);border-color:rgba(58,58,58,.08);box-shadow:none}
  .dark .cardstack li.shared{background:#070707;border-color:rgba(239,196,89,.12)}
  .cardstack .tag{display:block;font-weight:700;font-size:9px;letter-spacing:.24em;
    text-transform:uppercase;margin-bottom:var(--space-2)}
  .cardstack .tag.only{color:var(--gold-brown)}
  .dark .cardstack .tag.only{color:var(--gold)}
  .cardstack .tag.shared{color:#5F5B52}
  .dark .cardstack .tag.shared{color:#8A857A}
  .cardstack li.shared .num{color:#5F5B52}
  .dark .cardstack li.shared .num{color:#8A857A}

  /* The legend that tells the reader the gold means something. */
  .scopekey{display:flex;flex-wrap:wrap;gap:var(--space-6);margin-top:var(--space-6);
    padding:var(--space-3) 0;border-top:1px solid rgba(239,196,89,.25);
    border-bottom:1px solid rgba(239,196,89,.25)}
  .scopekey span{display:flex;align-items:center;gap:var(--space-2);
    font-weight:700;font-size:10px;letter-spacing:.20em;text-transform:uppercase;color:#5F5B52}
  .dark .scopekey span{color:#8A857A}
  .scopekey i{display:inline-block;width:14px;height:3px;border-radius:2px;background:#9A958A}
  .scopekey span.only{color:var(--gold-brown)} .scopekey span.only i{background:var(--gold-dark)}
  .dark .scopekey span.only{color:var(--gold)} .dark .scopekey span.only i{background:var(--gold)}

  /* ---- COMPONENT 05 · dark section tile ---- */
  .tile{background:var(--black);color:var(--cream-pale);padding:var(--space-8);
    border-radius:var(--radius-md);margin-top:var(--space-12);box-shadow:var(--shadow-lg)}
  .tile .eyebrow{font-weight:700;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:var(--space-4)}
  .tile .th{font-weight:700;font-size:clamp(20px,2.6vw,28px);line-height:1.2;letter-spacing:-.02em;color:var(--cream-pale);max-width:22ch}
  .tile .th em{font-style:normal;color:var(--gold)}
  .tile.gold-tile{background:var(--gold);color:var(--black);box-shadow:var(--shadow-gold)}
  .tile.gold-tile .eyebrow{color:rgba(0,0,0,.6)}
  .tile.gold-tile .th{color:var(--black);max-width:44ch}
  .tile.gold-tile .th em{color:var(--gold-brown);font-style:italic}

  /* ---- COMPONENT 06 · tracked-caps marquee ---- */
  .marquee{background:var(--black);border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);
    overflow:hidden;padding:var(--space-3) 0;position:relative;z-index:2}
  .marquee .track{display:flex;width:max-content;animation:mq 34s linear infinite}
  .marquee span{font-weight:700;font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);
    white-space:nowrap;padding:0 var(--space-6)}
  .marquee span::after{content:"\00B7";padding-left:var(--space-6);color:var(--gold-dark)}
  @keyframes mq{to{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){.marquee .track{animation:none}}

  /* ---- COMPONENT 07 · license footer bar (the watermark — never break) ---- */
  .licbar{display:flex;justify-content:space-between;align-items:center;gap:var(--space-6);flex-wrap:wrap;
    margin-top:var(--space-16);padding-top:var(--space-3);border-top:1px solid rgba(58,58,58,.2);
    font-weight:700;font-size:9px;letter-spacing:.32em;text-transform:uppercase;color:var(--charcoal)}
  .dark .licbar{color:var(--gold);border-top-color:rgba(239,196,89,.3)}
  @media(max-width:720px){.licbar{font-size:8px;letter-spacing:.22em}}

  /* ---- spec list (contract scope) ---- */
  .spec{list-style:none;margin-top:var(--space-12);border-top:1px solid rgba(58,58,58,.18)}
  .spec li{display:grid;grid-template-columns:64px 1fr;gap:var(--space-6);
    padding:var(--space-6) 0;border-bottom:1px solid rgba(58,58,58,.18);align-items:start}
  @media(max-width:620px){.spec li{grid-template-columns:1fr;gap:var(--space-2)}}
  .spec .num{font-weight:700;font-size:13px;letter-spacing:.30em;color:var(--gold-dark);padding-top:2px}
  .spec h3{font-weight:700;font-size:16px;line-height:1.3;color:var(--black);margin-bottom:var(--space-2)}
  .spec p{font-size:13px;line-height:1.5;color:var(--charcoal)}

  /* ---- spec table (panel data) ----

     Was flex + space-between with the value right-aligned. That reads badly the
     moment either side wraps: a two-line label leaves the value floating, and a
     right-aligned value has a ragged LEFT edge, so the eye has no column to
     return to. Alex caught it on the CoastalMAX panel, where "Coastal approval"
     wrapped to two lines and its value came apart across three.

     So it now uses the same row model as .spectable: a fixed label column, the
     value left-aligned against a consistent edge, labels set as tracked caps so
     a long one reads as a heading rather than as a wrapped sentence. Both spec
     styles now scan identically, which is the point. */
  .dl{margin-top:var(--space-6);border-top:1px solid rgba(239,196,89,.25)}
  .dl div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:var(--space-6);
    padding:var(--space-3) 0;border-bottom:1px solid rgba(239,196,89,.25);
    font-size:13px;align-items:baseline}
  .dl dt{font-weight:700;font-size:10px;letter-spacing:.20em;text-transform:uppercase;
    color:var(--muted);line-height:1.7}
  .dl dd{color:var(--cream-pale);font-weight:500;text-align:left;line-height:1.5;
    overflow-wrap:break-word}
  .dl dd.hi{color:var(--gold);font-weight:700}
  @media(max-width:620px){
    .dl div{grid-template-columns:1fr;gap:2px}
    .dl dt{line-height:1.6}
  }

  /* ---- two column ---- */
  .cols{display:grid;grid-template-columns:1.1fr .9fr;gap:var(--space-16);align-items:start;margin-top:var(--space-12)}
  @media(max-width:900px){.cols{grid-template-columns:1fr;gap:var(--space-12)}}
  .panel{background:var(--black);color:var(--cream-pale);padding:var(--space-8);border-radius:var(--radius-md);box-shadow:var(--shadow-lg)}
  .panel .eyebrow{font-weight:700;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:var(--space-4)}
  .panel .note{margin-top:var(--space-6);padding-top:var(--space-4);border-top:1px solid rgba(239,196,89,.25);
    font-size:13px;line-height:1.6;color:#C9C4B4}
  .panel .note b{color:var(--gold);font-weight:700}
  .card{background:var(--white);border:1px solid rgba(58,58,58,.14);border-radius:var(--radius-md);
    padding:var(--space-8);box-shadow:var(--shadow-md)}
  .card h3{font-weight:700;font-size:18px;color:var(--black);margin-bottom:var(--space-4)}
  .card p{font-size:13px;line-height:1.55;color:var(--charcoal);margin-bottom:var(--space-3)}
  .card p:last-child{margin-bottom:0}
  .card p b{font-weight:700;color:var(--black)}

  /* ---- pull quote ---- */
  .pull{max-width:60ch;margin-top:var(--space-8);padding-left:var(--space-6);border-left:3px solid var(--gold);
    font-family:var(--serif);font-style:italic;font-weight:500;font-size:clamp(18px,2.3vw,24px);line-height:1.35;color:var(--gold)}
  .pull .attr{display:block;margin-top:var(--space-4);font-family:var(--sans);font-style:normal;font-weight:700;
    font-size:10px;letter-spacing:.30em;text-transform:uppercase;color:var(--muted)}

  /* ---- swatches ---- */
  .swatches{display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-4);margin-top:var(--space-12)}
  @media(max-width:820px){.swatches{grid-template-columns:repeat(2,1fr)}}
  .sw{text-align:center}
  .sw .chip{height:72px;border-radius:var(--radius-sm);border:1px solid rgba(58,58,58,.18)}
  .sw.sel .chip{border:2px solid var(--gold-dark);box-shadow:var(--shadow-gold)}
  .sw .nm{font-weight:700;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:var(--space-3)}
  .sw.sel .nm{color:var(--gold-dark)}
  .sw .pk{font-weight:700;font-size:9px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold-brown);margin-top:2px}

  /* ---- COMPONENT 08 · spec sheet ----
     A specification is READ, not scanned for a number. It gets quiet type, a
     fixed label column and tight rows.
     Do NOT render specs with .invoice/.irow. That component sets .amt at 24px
     bold and pushes it to the far right, which is correct for a dollar figure
     and wrong for "GAF 60 mil EverGuard or 50 mil Extreme" — the value reads as
     a price and the gap between label and value opens into a canyon.
     Never put a real customer figure in a comment here: this stylesheet is
     inlined into every page, so it would ship one client's number to another. */
  .spectable{margin-top:var(--space-8);background:var(--white);
    border:1px solid rgba(58,58,58,.14);border-radius:var(--radius-md);
    overflow:hidden;box-shadow:var(--shadow-sm)}
  .dark .spectable{background:#0b0b0b;border-color:rgba(239,196,89,.22)}
  .spectable .sh{background:var(--black);padding:var(--space-3) var(--space-6);
    font-weight:700;font-size:10px;letter-spacing:.30em;text-transform:uppercase;
    color:var(--gold);border-bottom:1px solid rgba(239,196,89,.35)}
  .spectable dl{margin:0}
  .spectable .srow{display:grid;grid-template-columns:170px minmax(0,1fr);
    gap:var(--space-6);padding:var(--space-3) var(--space-6);
    border-bottom:1px solid rgba(58,58,58,.10);align-items:baseline}
  .spectable dl .srow:last-child{border-bottom:none}
  .spectable dl .srow:nth-child(even){background:var(--cream-pale)}
  .dark .spectable .srow{border-bottom-color:rgba(239,196,89,.16)}
  .dark .spectable dl .srow:nth-child(even){background:rgba(239,196,89,.05)}
  .spectable dt{font-weight:700;font-size:10px;letter-spacing:.22em;
    text-transform:uppercase;color:var(--muted);line-height:1.9}
  .spectable dd{font-size:14px;font-weight:500;line-height:1.5;color:var(--black);
    overflow-wrap:break-word}
  .dark .spectable dd{color:var(--cream-pale)}
  @media(max-width:620px){
    .spectable .srow{grid-template-columns:1fr;gap:2px;padding:var(--space-3) var(--space-4)}
    .spectable dt{line-height:1.6}
  }

  /* ---- COMPONENT 09 · work photo ----
     A real Arry's roof, hotlinked from arrysroofing.com. Never stock, never AI.
     Hotlinked rather than committed so the estimates repo stays text only and
     the marketing team keeps control of its own photography. */
  .shot{margin-top:var(--space-12);border-radius:var(--radius-md);overflow:hidden;
    background:var(--black);box-shadow:var(--shadow-lg)}
  .shot img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}
  .shot figcaption{padding:var(--space-3) var(--space-6);
    font-weight:700;font-size:10px;letter-spacing:.28em;text-transform:uppercase;
    color:var(--gold);background:var(--black)}
  @media(max-width:620px){.shot img{aspect-ratio:4/3}}
  @media print{.shot{box-shadow:none;border-radius:0}.shot img{max-height:88mm}}

  /* ---- invoice ---- */
  .invoice{margin-top:var(--space-12);background:var(--white);border:1px solid rgba(58,58,58,.16);
    border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow-lg)}
  .invoice .ih{background:var(--black);padding:var(--space-6) var(--space-8);
    display:flex;justify-content:space-between;gap:var(--space-6);flex-wrap:wrap;align-items:center}
  .invoice .ih .t{font-weight:700;font-size:16px;color:var(--gold);letter-spacing:-.01em}
  .invoice .ih .m{font-weight:700;font-size:9px;letter-spacing:.30em;text-transform:uppercase;color:var(--muted);line-height:2}
  .irow{display:grid;grid-template-columns:1fr auto;gap:var(--space-8);padding:var(--space-6) var(--space-8);
    border-bottom:1px solid rgba(58,58,58,.14);align-items:start}
  @media(max-width:620px){.irow{grid-template-columns:1fr;gap:var(--space-3)}}
  .irow h3{font-weight:700;font-size:15px;color:var(--black);margin-bottom:var(--space-2)}
  .irow p{font-size:13px;line-height:1.5;color:var(--charcoal);max-width:62ch}
  .irow .amt{font-weight:700;font-size:24px;letter-spacing:-.025em;color:var(--black);white-space:nowrap}
  .irow.addon{background:var(--cream-pale)}
  .irow.addon .amt{color:var(--gold-dark)}
  .irow.total{background:var(--black);border-bottom:none;align-items:center}
  .irow.total h3{color:var(--gold);font-size:11px;letter-spacing:.30em;text-transform:uppercase;margin-bottom:var(--space-2)}
  .irow.total p{color:var(--muted)}
  .irow.total .amt{font-size:clamp(34px,5vw,52px);line-height:1;
    background:var(--gradient-gold);-webkit-background-clip:text;background-clip:text;color:transparent}


  /* ---- COMPONENT 11 · people cards ----
     Who is physically turning up. Written for the HOA notice, where the page is
     read by a resident deciding whether to be worried about the stranger on a
     ladder — a name and a face does more work there than any paragraph.

     The portrait follows the same rule as the hero seal: a BLACK face with a
     gold rim, never a gold disc. Arry's mark and most headshots both die on
     gold. When no photograph exists yet the initials render on that same black
     face, so the card is complete rather than broken — a missing image must
     never leave a hole in a document going to a whole community. */
  .people{list-style:none;margin-top:var(--space-12);display:grid;gap:var(--space-6);
    grid-template-columns:repeat(2,1fr)}
  @media(max-width:820px){.people{grid-template-columns:1fr}}
  .person{background:var(--white);border:1px solid rgba(58,58,58,.12);border-radius:var(--radius-md);
    padding:var(--card-padding);box-shadow:var(--shadow-sm);
    display:grid;grid-template-columns:auto 1fr;gap:var(--space-6);align-items:start}
  .dark .person{background:#0b0b0b;border-color:rgba(239,196,89,.22)}
  @media(max-width:480px){.person{grid-template-columns:1fr;gap:var(--space-4)}}
  .person .ph{width:96px;height:96px;border-radius:50%;overflow:hidden;flex:none;
    background:#0a0a0a;border:3px solid var(--gold-deep,#D4A041);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 8px 22px rgba(154,119,24,.34), inset 0 -4px 10px rgba(0,0,0,.45)}
  .person .ph img{width:100%;height:100%;object-fit:cover;display:block}
  .person .ini{font-weight:700;font-size:28px;letter-spacing:.06em;color:var(--gold)}
  .person .nm{font-weight:700;font-size:18px;line-height:1.25;color:var(--black)}
  .dark .person .nm{color:var(--cream-pale)}
  .person .rl{font-weight:700;font-size:10px;letter-spacing:.30em;text-transform:uppercase;
    color:var(--gold-dark);margin-top:var(--space-2)}
  .dark .person .rl{color:var(--gold)}
  .person p{font-size:13px;line-height:1.5;color:var(--charcoal);margin-top:var(--space-3);max-width:46ch}
  .dark .person p{color:#C9C4B4}
  .person .tel{display:inline-block;margin-top:var(--space-3);text-decoration:none;
    font-weight:700;font-size:12px;letter-spacing:.10em;color:var(--gold-dark);white-space:nowrap}
  .dark .person .tel{color:var(--gold)}
  @media print{
    .people{grid-template-columns:repeat(2,1fr);gap:8mm}
    .person{box-shadow:none;border:1px solid rgba(58,58,58,.3);border-radius:0;
      page-break-inside:avoid;break-inside:avoid}
    .person .ph{width:66px;height:66px;box-shadow:none}
  }

  /* ---- COMPONENT 12 · timeline ----
     A sequence, where .cardstack would say "a set of unrelated points".

     Written because the Virginia Crossing notice ran card stacks on two
     consecutive pages and the second one stopped being read — identical boxes
     back to back look like the same page twice. "What happens next" is
     genuinely ordered in a way findings are not, so it gets a rail with the
     steps hung off it and the order carries the meaning. */
  .timeline{list-style:none;margin-top:var(--space-12);position:relative;
    padding-left:var(--space-8)}
  .timeline::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:1px;
    background:linear-gradient(180deg,var(--gold-dark),rgba(212,160,65,.15))}
  .dark .timeline::before{background:linear-gradient(180deg,var(--gold),rgba(239,196,89,.15))}
  .timeline li{position:relative;padding-bottom:var(--space-12)}
  .timeline li:last-child{padding-bottom:0}
  .timeline li::before{content:"";position:absolute;left:calc(-1 * var(--space-8) + 3px);top:5px;
    width:9px;height:9px;border-radius:50%;background:var(--cream);
    border:2px solid var(--gold-dark);box-shadow:0 0 0 4px var(--cream)}
  .dark .timeline li::before{background:var(--black);border-color:var(--gold);
    box-shadow:0 0 0 4px var(--black)}
  .timeline .num{font-weight:700;font-size:11px;letter-spacing:.30em;color:var(--gold-dark);
    display:block;margin-bottom:var(--space-2)}
  .dark .timeline .num{color:var(--gold)}
  .timeline h3{font-weight:700;font-size:19px;line-height:1.25;color:var(--black);
    margin-bottom:var(--space-2);max-width:34ch}
  .dark .timeline h3{color:var(--cream-pale)}
  .timeline p{font-size:14px;line-height:1.6;color:var(--charcoal);max-width:60ch}
  .dark .timeline p{color:#C9C4B4}
  @media(max-width:620px){
    .timeline h3{font-size:16px}
    .timeline li{padding-bottom:var(--space-8)}
  }
  @media print{
    .timeline li{page-break-inside:avoid;break-inside:avoid;padding-bottom:9mm}
    .timeline li::before{box-shadow:none}
  }

  /* ---- COMPONENT 13 · coverage ledger ----
     Two futures for the same roof, side by side. The whole argument for
     inspecting a community while its warranty is live is a comparison — the
     identical defect is a manufacturer's bill on one side of a date and the
     owners' bill on the other — and a comparison is the one thing a list
     cannot make. Left column is the outcome we want and carries the gold;
     right column is deliberately drained of it. */
  .ledger{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-6);margin-top:var(--space-12)}
  @media(max-width:820px){.ledger{grid-template-columns:1fr}}
  .ledger .col{border-radius:var(--radius-md);padding:var(--space-8);
    border:1px solid rgba(58,58,58,.14);background:var(--white);box-shadow:var(--shadow-sm)}
  .dark .ledger .col{background:#0b0b0b;border-color:rgba(255,255,255,.10)}
  .ledger .col.now{border-color:var(--gold-dark);box-shadow:var(--shadow-gold)}
  .dark .ledger .col.now{border-color:var(--gold)}
  .ledger .ch{font-weight:700;font-size:10px;letter-spacing:.32em;text-transform:uppercase;
    color:var(--muted);padding-bottom:var(--space-4);border-bottom:1px solid rgba(58,58,58,.14)}
  .ledger .col.now .ch{color:var(--gold-dark)}
  .dark .ledger .col.now .ch{color:var(--gold)}
  .dark .ledger .ch{border-bottom-color:rgba(255,255,255,.12)}
  .ledger .ct{font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:clamp(20px,2.4vw,26px);line-height:1.2;color:var(--charcoal);margin-top:var(--space-4)}
  .ledger .col.now .ct{color:var(--black)}
  .dark .ledger .ct{color:#C9C4B4}
  .dark .ledger .col.now .ct{color:var(--cream-pale)}
  .ledger ul{list-style:none;margin-top:var(--space-6);display:grid;gap:var(--space-4)}
  .ledger li{font-size:14px;line-height:1.55;color:var(--charcoal);padding-left:var(--space-6);position:relative}
  .dark .ledger li{color:#C9C4B4}
  .ledger li::before{content:"\2014";position:absolute;left:0;color:var(--muted)}
  .ledger .col.now li::before{content:"\2713";color:var(--gold-dark);font-weight:700}
  .dark .ledger .col.now li::before{color:var(--gold)}
  .ledger li b{font-weight:700;color:var(--black)}
  .dark .ledger li b{color:var(--gold-bright)}
  @media print{
    .ledger{gap:6mm}
    .ledger .col{box-shadow:none;border-radius:0;border:1px solid rgba(58,58,58,.3);
      page-break-inside:avoid;break-inside:avoid}
    .ledger .col.now{border:1.5px solid var(--black)}
  }

  /* ---- COMPONENT 14 · question stack ----
     The plainest thing in the system, on purpose.

     A resident notice is read by somebody with four specific worries and no
     interest in a presentation. Set as questions in their own words with the
     answer directly underneath, the page stops performing and starts
     answering — which is a different document from the same facts arranged as
     benefits. No boxes: a hairline rule per question, so twelve of them read
     as one calm list rather than twelve competing cards. */
  .qa{list-style:none;margin-top:var(--space-12);display:grid;gap:0}
  .qa li{padding:var(--space-8) 0;border-top:1px solid rgba(58,58,58,.16)}
  .dark .qa li{border-top-color:rgba(239,196,89,.22)}
  .qa li:last-child{border-bottom:1px solid rgba(58,58,58,.16)}
  .dark .qa li:last-child{border-bottom-color:rgba(239,196,89,.22)}
  .qa .q{font-weight:700;font-size:clamp(17px,2vw,21px);line-height:1.3;color:var(--black);
    max-width:44ch;display:flex;gap:var(--space-4)}
  .dark .qa .q{color:var(--cream-pale)}
  .qa .q::before{content:"?";flex:none;font-weight:700;color:var(--gold-dark);
    font-size:.9em;line-height:1.3}
  .dark .qa .q::before{color:var(--gold)}
  .qa .a{font-size:14px;line-height:1.65;color:var(--charcoal);max-width:64ch;
    margin-top:var(--space-3);padding-left:calc(var(--space-4) + .7em)}
  .dark .qa .a{color:#C9C4B4}
  .qa .a b{font-weight:700;color:var(--black)}
  .dark .qa .a b{color:var(--gold-bright)}
  @media(max-width:620px){
    .qa li{padding:var(--space-6) 0}
    .qa .a{padding-left:0;margin-top:var(--space-2)}
  }
  @media print{
    .qa li{page-break-inside:avoid;break-inside:avoid;padding:6mm 0}
  }

  /* ---- COMPONENT 10 · sign band ----
     The last thing on the page. Takes the customer to the ServiceTitan proposal
     where they sign and pay. The link is supplied per job by the salesperson —
     it can never be generated, and it is never taken from anywhere but them. */
  .signband{background:var(--black);padding:var(--space-16) var(--space-8);text-align:center;
    position:relative;z-index:2;border-top:1px solid rgba(239,196,89,.35)}
  .signband .eyebrow{font-weight:700;font-size:10px;letter-spacing:.32em;text-transform:uppercase;
    color:var(--gold);margin-bottom:var(--space-4)}
  .signband h2{font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:clamp(24px,3.4vw,36px);line-height:1.2;color:var(--cream-pale);
    max-width:20ch;margin:0 auto var(--space-8)}
  .signbtn{display:inline-block;text-decoration:none;padding:18px 44px;border-radius:9999px;
    background:var(--gradient-gold);color:var(--black);
    font-weight:700;font-size:12px;letter-spacing:.24em;text-transform:uppercase;
    box-shadow:var(--shadow-gold);transition:transform .2s ease,box-shadow .2s ease}
  .signbtn:hover{transform:translateY(-2px);box-shadow:0 8px 34px rgba(239,196,89,.45)}
  .signband .fine{margin-top:var(--space-6);font-size:12px;line-height:1.6;color:var(--muted);
    max-width:52ch;margin-left:auto;margin-right:auto}
  .signband .fine a{color:var(--gold-dark);word-break:break-all}
  @media print{
    .signband{padding:18mm 0;page-break-inside:avoid}
    .signbtn{background:none;color:var(--black);border:1.5px solid var(--black);box-shadow:none}
    .signband h2{color:var(--black)}
    .signband .eyebrow{color:var(--gold-brown)}
  }

  /* ---- chrome ---- */
  #prog{position:fixed;top:0;left:0;height:3px;width:0;z-index:100;background:var(--gradient-gold)}
  header{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;justify-content:space-between;align-items:center;
    padding:var(--space-3) var(--space-8);background:rgba(0,0,0,.94);backdrop-filter:blur(9px);border-bottom:1px solid rgba(239,196,89,.35)}
  .logo{display:flex;align-items:center;gap:var(--space-3);font-weight:700;font-size:15px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--cream-pale)}
  .logo img{width:36px;height:36px;border-radius:var(--radius-sm)}
  .logo b{color:var(--gold);font-weight:700}
  .hdr-r{font-weight:700;font-size:9px;letter-spacing:.30em;text-transform:uppercase;color:var(--muted)}
  @media(max-width:720px){.hdr-r{display:none}}
  #dots{position:fixed;right:20px;top:50%;transform:translateY(-50%);z-index:50;display:flex;flex-direction:column;gap:10px}
  #dots a{width:6px;height:6px;border-radius:50%;border:1px solid var(--gold-dark);display:block;transition:.3s;background:rgba(255,250,227,.6)}
  #dots a.act{background:var(--gold);height:20px;border-radius:9999px;box-shadow:var(--shadow-gold)}
  @media(max-width:900px){#dots{display:none}}
  footer{padding:var(--space-8);background:var(--black);display:flex;justify-content:space-between;align-items:center;
    gap:var(--space-6);flex-wrap:wrap;position:relative;z-index:2;border-top:1px solid rgba(239,196,89,.35);
    font-weight:700;font-size:9px;letter-spacing:.30em;text-transform:uppercase;color:var(--gold)}
  footer .fl{display:flex;align-items:center;gap:var(--space-3)}
  footer img{width:30px;height:30px;border-radius:var(--radius-sm)}
  @media(max-width:720px){footer{font-size:8px;letter-spacing:.2em}}

  .rv{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease}
  .rv.on{opacity:1;transform:none}
  .d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}

  /* ============================================================
     COVER — preserved verbatim. Scoped to #hero only so the
     brand system above cannot reach it.
     ============================================================ */
  #hero{--card:#FFFFFF;--gold-deep:#D4A041;--gold-pale:#FCFBE7;--bay:#D4A041;
    --ink:#000000;--ink-soft:#3A3A3A;--hero-cream:#FFFAE3;
    min-height:100vh;display:flex;align-items:center;justify-content:center;padding:130px 8vw 104px;
    font-family:'Figtree','Segoe UI',system-ui,-apple-system,sans-serif;font-weight:300;line-height:1.75;color:var(--ink);
    background:radial-gradient(1000px 540px at 20% 10%, rgba(30,110,126,.1), transparent 60%),
      radial-gradient(900px 520px at 85% 90%, rgba(201,162,39,.14), transparent 62%),var(--hero-cream)}
  #hero .letter{max-width:880px;background:var(--card);border:1.4px solid rgba(154,119,24,.4);
    padding:0 0 clamp(36px,5vw,64px);position:relative;z-index:2;text-align:center;box-shadow:0 30px 80px rgba(30,26,18,.22)}
  #hero .letter::before{content:"";position:absolute;inset:10px;border:1px solid rgba(154,119,24,.3);pointer-events:none;z-index:3}
  #hero .cover-wrap{position:relative;overflow:hidden;margin:0 0 8px}
  #hero .cover-wrap img{width:100%;display:block}
  #hero .cover-wrap::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(255,254,248,.96))}
  #hero .cover-tag{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:4;white-space:nowrap;
    font-size:9.5px;letter-spacing:.34em;text-transform:uppercase;color:var(--gold-deep);font-weight:600}
  #hero .inner{padding:0 clamp(28px,5vw,72px)}
  /* The mark is gold line-work with no fill of its own. On a gold disc it disappears,
     so the seal is a black face with a gold rim and the mark sits on the black. */
  #hero .seal{width:78px;height:78px;border-radius:50%;margin:-6px auto 22px;display:flex;align-items:center;justify-content:center;position:relative;z-index:4;
    background:#0a0a0a;border:3px solid var(--gold-deep);
    box-shadow:0 10px 28px rgba(154,119,24,.5), inset 0 -4px 10px rgba(0,0,0,.45)}
  #hero .seal img{width:58px;height:58px;border-radius:0;border:0}
  #hero .to{font-size:11px;letter-spacing:.4em;text-transform:uppercase;color:var(--gold-deep);font-weight:600}
  #hero h1{font-family:'Playfair Display',Georgia,'Times New Roman',serif;font-size:clamp(40px,5.6vw,76px);font-weight:500;
    line-height:1.1;color:var(--ink);letter-spacing:normal;margin:16px 0 6px}
  #hero .addr{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:19px;color:var(--bay)}
  #hero .body{max-width:600px;margin:26px auto 0;color:var(--ink-soft);font-size:16px;line-height:1.75}
  #hero .body strong{color:var(--ink);font-weight:500}
  #hero .sig{margin-top:30px}
  #hero .sig .name{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:24px;color:var(--ink)}
  #hero .sig .role{font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-soft);margin-top:4px}

  @media print{
    /* browsers strip backgrounds on print unless told otherwise — this is essential */
    *{-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important}
    @page{size:letter;margin:14mm 12mm}
    html,body{background:#fff}
    #prog,#dots,header{display:none !important}
    .rv{opacity:1 !important;transform:none !important}
    .marquee{display:none}

    /* cover owns page one, whole and unbroken — tightened so it fits */
    #hero{min-height:auto;padding:0;background:none;page-break-after:always;break-after:page}
    #hero .letter{box-shadow:none;max-width:100%;padding-bottom:20px;page-break-inside:avoid;break-inside:avoid}
    #hero .cover-wrap img{max-height:74mm;object-fit:cover;object-position:center 42%}
    #hero .inner{padding:0 28px}
    #hero .seal{width:56px;height:56px;margin:-4px auto 12px}
    #hero .seal img{width:40px;height:40px}
    #hero h1{font-size:40px;margin:10px 0 4px}
    #hero .addr{font-size:15px}
    #hero .body{font-size:12px;line-height:1.6;margin-top:14px;max-width:520px}
    #hero .sig{margin-top:16px}
    #hero .sig .name{font-size:18px}

    /* every section starts a fresh page */
    section{page-break-before:always;break-before:page;padding:0 0 8mm}
    #hero{page-break-before:auto;break-before:auto}

    /* never split a unit across a page boundary */
    .card,.panel,.tile,.invoice,.cardstack li,.statblock,.swatches,.pull,
    .spec li,.numlist li,.licbar,.irow,.spectable,.spectable .srow{page-break-inside:avoid;break-inside:avoid}
    .rail{page-break-after:avoid;break-after:avoid}
    .h1,.sub,.h3{page-break-after:avoid;break-after:avoid}

    /* the print brochure uses no rounded corners */
    .card,.panel,.tile,.invoice,.spectable,.cardstack li,.sw .chip,.logo img,footer img{border-radius:0}
    .invoice,.card,.spectable{box-shadow:none;border:1px solid rgba(58,58,58,.3)}
    .panel,.tile{box-shadow:none}
    .cols{gap:32px}
    footer{page-break-before:avoid;break-before:avoid}
  }

</style>
